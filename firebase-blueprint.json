{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public chat identity profile for an Alap user without hidden PII.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Visible display name" },
        "handle": { "type": "string", "description": "Unique-style handle without @ prefix" },
        "about": { "type": "string", "description": "Short bio / status line" },
        "avatarId": { "type": "string", "description": "Bundled offline avatar identifier" },
        "publicPhoneNumber": { "type": "string", "description": "Mobile number only if user allows public visibility, else empty" },
        "publicUserId": { "type": "string", "description": "Alap User ID only if user allows public visibility, else empty" },
        "hidePhoneNumber": { "type": "boolean", "description": "Toggle to hide mobile number from others" },
        "hideUserId": { "type": "boolean", "description": "Toggle to hide User ID & handle from others" },
        "hideOnlineStatus": { "type": "boolean", "description": "Toggle to hide online dot and last seen" },
        "hideAbout": { "type": "boolean", "description": "Toggle to hide About bio from others" },
        "hideReadReceipts": { "type": "boolean", "description": "Toggle to hide read receipt blue ticks" },
        "blockedUids": { "type": "array", "description": "UIDs blocked by this user" },
        "isProfileCompleted": { "type": "boolean", "description": "Whether user completed post-verification profile setup" },
        "isDiscoverable": { "type": "boolean", "description": "Whether user appears in directory search" },
        "isOnline": { "type": "boolean", "description": "Presence indicator" },
        "isVerified": { "type": "boolean", "description": "Admin-assigned verified badge" },
        "isSuspended": { "type": "boolean", "description": "Admin moderation suspension state" },
        "isStudent": { "type": "boolean", "description": "Optional Student Mode flag (ST badge)" },
        "studentClass": { "type": "string", "description": "Optional class, batch, or department" },
        "studentSubject": { "type": "string", "description": "Optional favorite or focus subject" },
        "accountType": { "type": "string", "enum": ["student", "personal", "teacher", "guest"], "description": "Account tier: locked student, 18+ personal, admin-verified teacher, or guest-only transparency account" },
        "isTeacher": { "type": "boolean", "description": "Admin-assigned verified teacher status (TR badge)" },
        "teacherSubject": { "type": "string", "description": "Optional teacher subject or coaching specialty" },
        "teacherPlanId": { "type": "string", "description": "Admin-assigned teacher subscription plan ID" },
        "teacherPlanName": { "type": "string", "description": "Display name of assigned teacher plan" },
        "teacherBillingCycle": { "type": "string", "enum": ["none", "free", "monthly", "yearly"], "description": "Teacher billing cycle" },
        "teacherSubscriptionStatus": { "type": "string", "enum": ["none", "free_launch", "active", "grace", "expired"], "description": "Teacher subscription status" },
        "teacherPlanExpiresAtEpochMs": { "type": "integer", "description": "Optional plan expiration timestamp in ms (0 = unlimited/free launch)" },
        "guestEmail": { "type": "string", "description": "Verified Google Sign-In email exposed for anti-fraud accountability on Guest accounts" },
        "guestDeviceInfo": { "type": "string", "description": "Device model & OS label exposed for anti-fraud accountability on Guest accounts" },
        "guestJoinedAtEpochMs": { "type": "integer", "description": "Guest account creation epoch timestamp in ms" },
        "lastSeenAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last activity" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of profile creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of profile update" }
      },
      "required": [
        "userId",
        "displayName",
        "handle",
        "about",
        "avatarId",
        "publicPhoneNumber",
        "publicUserId",
        "hidePhoneNumber",
        "hideUserId",
        "hideOnlineStatus",
        "hideAbout",
        "isProfileCompleted",
        "isDiscoverable",
        "isOnline",
        "isVerified",
        "isSuspended",
        "lastSeenAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing the user's Google account email, mobile number, and private Alap ID.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "email": { "type": "string", "description": "Verified Gmail address" },
        "phoneNumber": { "type": "string", "description": "User's private mobile number" },
        "alapId": { "type": "string", "description": "User's Alap User ID" },
        "birthYear": { "type": "integer", "description": "Private birth year for under-18 student account age lock" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "email", "phoneNumber", "alapId", "createdAt", "updatedAt"]
    },
    "EmailVerificationOtp": {
      "title": "EmailVerificationOtp",
      "description": "Owner-only 6-digit Gmail verification challenge record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "email": { "type": "string", "description": "Target Gmail address" },
        "code": { "type": "string", "description": "6-digit verification code" },
        "expiresAtEpochMs": { "type": "integer", "description": "Expiry timestamp in ms" },
        "attempts": { "type": "integer", "description": "Failed verification attempt count" },
        "verified": { "type": "boolean", "description": "Whether challenge is verified" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "email", "code", "expiresAtEpochMs", "attempts", "verified", "createdAt", "updatedAt"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Delegated admin record manageable by the primary bootstrapped admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin UID" },
        "email": { "type": "string", "description": "Admin email" },
        "addedBy": { "type": "string", "description": "Primary admin UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["uid", "email", "addedBy", "createdAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Admin-controlled global app settings and feature flags.",
      "type": "object",
      "properties": {
        "appTagline": { "type": "string", "description": "Subtle app tagline shown on auth/settings" },
        "maintenanceBanner": { "type": "string", "description": "Optional global notice text" },
        "isReadOnlyMode": { "type": "boolean", "description": "If true, disables sending new messages for non-admins" },
        "allowStatusUpdates": { "type": "boolean", "description": "Whether 24h status posting is enabled" },
        "allowGroupCreation": { "type": "boolean", "description": "Whether users can create new groups" },
        "forceUpdateRequired": { "type": "boolean", "description": "Whether clients below minAppVersion must update" },
        "maxMessageLength": { "type": "integer", "description": "Max characters per text message" },
        "minAppVersion": { "type": "string", "description": "Minimum recommended app version" },
        "latestApkUrl": { "type": "string", "description": "Direct HTTPS APK download URL for in-app auto-updater" },
        "latestVersionCode": { "type": "integer", "description": "Latest published Android versionCode" },
        "updatedBy": { "type": "string", "description": "Admin UID who updated config" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "appTagline",
        "maintenanceBanner",
        "isReadOnlyMode",
        "allowStatusUpdates",
        "allowGroupCreation",
        "maxMessageLength",
        "minAppVersion",
        "updatedBy",
        "updatedAt"
      ]
    },
    "AdminApiKey": {
      "title": "AdminApiKey",
      "description": "Primary-admin issued API key for external web dashboards and automation.",
      "type": "object",
      "properties": {
        "label": { "type": "string", "description": "Human-readable key name" },
        "apiKey": { "type": "string", "description": "Generated API key token" },
        "scopes": { "type": "array", "description": "Authorized permission scopes" },
        "isActive": { "type": "boolean", "description": "Whether the key is enabled" },
        "createdBy": { "type": "string", "description": "Primary admin UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["label", "apiKey", "scopes", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "DevicePushToken": {
      "title": "DevicePushToken",
      "description": "FCM push notification token registered by a signed-in user device.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "token": { "type": "string", "description": "Firebase Cloud Messaging device registration token" },
        "platform": { "type": "string", "description": "Client platform (android)" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "token", "platform", "updatedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Admin-published update banner and local push notification trigger.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Banner & notification title" },
        "message": { "type": "string", "description": "Banner & notification body" },
        "versionTag": { "type": "string", "description": "Optional release tag e.g. v2.0" },
        "priority": { "type": "string", "enum": ["update", "info", "urgent"], "description": "Announcement category" },
        "isActive": { "type": "boolean", "description": "Whether banner is visible to users" },
        "createdBy": { "type": "string", "description": "Admin UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["title", "message", "versionTag", "priority", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct or group conversation room metadata.",
      "type": "object",
      "properties": {
        "chatType": { "type": "string", "enum": ["direct", "group"], "description": "Conversation kind" },
        "title": { "type": "string", "description": "Group title (empty for direct)" },
        "description": { "type": "string", "description": "Group description" },
        "avatarId": { "type": "string", "description": "Bundled avatar identifier" },
        "participantUids": { "type": "array", "description": "Participant UIDs (2..50)" },
        "adminUids": { "type": "array", "description": "Group admin UIDs" },
        "createdBy": { "type": "string", "description": "Creator UID" },
        "lastMessageText": { "type": "string", "description": "Preview of last message" },
        "lastMessageSenderId": { "type": "string", "description": "Sender UID of last message" },
        "lastMessageType": { "type": "string", "enum": ["text", "sticker", "poll", "quiz", "flashcard", "system"], "description": "Type of last message" },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last message" },
        "disappearingHours": { "type": "integer", "description": "Auto-expire hours: 0, 24, or 168" },
        "isStudyGroup": { "type": "boolean", "description": "Whether this group is a Study Group" },
        "studyLockToAdmin": { "type": "boolean", "description": "If true, only group admins/teachers can add Study Board items, quizzes, and flashcards" },
        "inviteCode": { "type": "string", "description": "Optional 6-character Study Group invite code" },
        "typingUids": { "type": "array", "description": "Currently typing UIDs" },
        "pinnedByUids": { "type": "array", "description": "UIDs who pinned this chat" },
        "mutedByUids": { "type": "array", "description": "UIDs who muted this chat" },
        "archivedByUids": { "type": "array", "description": "UIDs who archived this chat" },
        "unreadCounts": { "type": "object", "description": "Map of UID to unread integer count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "chatType",
        "title",
        "description",
        "avatarId",
        "participantUids",
        "adminUids",
        "createdBy",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageType",
        "lastMessageAt",
        "typingUids",
        "pinnedByUids",
        "mutedByUids",
        "archivedByUids",
        "unreadCounts",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Lightweight text, bundled sticker, or group poll message inside a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "senderId": { "type": "string", "description": "Author UID" },
        "senderName": { "type": "string", "description": "Author display name snapshot" },
        "text": { "type": "string", "description": "Message body" },
        "messageType": { "type": "string", "enum": ["text", "sticker", "poll", "quiz", "flashcard", "system"], "description": "Message payload type" },
        "stickerId": { "type": "string", "description": "Optional bundled local sticker key" },
        "pollQuestion": { "type": "string", "description": "Optional poll or quiz question" },
        "pollOptions": { "type": "array", "description": "Optional poll or quiz choices" },
        "pollVotes": { "type": "object", "description": "Map of UID to selected option index" },
        "correctOptionIndex": { "type": "integer", "description": "Zero-based correct answer index for quiz messages" },
        "quizExplanation": { "type": "string", "description": "Optional explanation shown after answering a quiz" },
        "flashcardFront": { "type": "string", "description": "Question or front prompt for flashcard messages" },
        "flashcardBack": { "type": "string", "description": "Answer or back explanation for flashcard messages" },
        "replyToMessageId": { "type": "string", "description": "Optional quoted message ID" },
        "replyToSenderName": { "type": "string", "description": "Optional quoted sender name" },
        "replyToPreview": { "type": "string", "description": "Optional quoted snippet" },
        "isForwarded": { "type": "boolean", "description": "Forwarded badge flag" },
        "isEdited": { "type": "boolean", "description": "Edited badge flag" },
        "isDeleted": { "type": "boolean", "description": "Soft-deleted for everyone flag" },
        "participantUids": { "type": "array", "description": "Denormalized chat participant UIDs" },
        "readByUids": { "type": "array", "description": "UIDs who read this message" },
        "starredByUids": { "type": "array", "description": "UIDs who starred this message" },
        "reactions": { "type": "object", "description": "Map of UID to reaction emoji" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "chatId",
        "senderId",
        "senderName",
        "text",
        "messageType",
        "isForwarded",
        "isEdited",
        "isDeleted",
        "participantUids",
        "readByUids",
        "starredByUids",
        "reactions",
        "createdAt",
        "updatedAt"
      ]
    },
    "StatusUpdate": {
      "title": "StatusUpdate",
      "description": "Lightweight 24-hour text status update.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "authorAvatarId": { "type": "string", "description": "Author bundled avatar ID" },
        "text": { "type": "string", "description": "Status message body" },
        "styleKey": { "type": "string", "enum": ["emerald", "slate", "charcoal", "sand"], "description": "Minimal background style" },
        "isPublic": { "type": "boolean", "description": "Visible to signed-in Alap users" },
        "viewerUids": { "type": "array", "description": "UIDs who viewed this status" },
        "expiresAtEpochMs": { "type": "integer", "description": "Expiry epoch milliseconds (24h)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": [
        "userId",
        "authorName",
        "authorAvatarId",
        "text",
        "styleKey",
        "isPublic",
        "viewerUids",
        "expiresAtEpochMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin security & moderation log entry.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "description": "Acting admin UID" },
        "adminEmail": { "type": "string", "description": "Acting admin email" },
        "action": { "type": "string", "description": "Action code" },
        "targetId": { "type": "string", "description": "Target user or document ID" },
        "details": { "type": "string", "description": "Summary of action" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["adminUid", "adminEmail", "action", "targetId", "details", "createdAt"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "User-submitted abuse or spam report reviewed in Admin Console.",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string", "description": "Reporter UID" },
        "targetUid": { "type": "string", "description": "Reported user UID" },
        "targetName": { "type": "string", "description": "Reported user name snapshot" },
        "chatId": { "type": "string", "description": "Optional related chat ID" },
        "reason": { "type": "string", "description": "Report reason" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"], "description": "Moderation status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["reporterUid", "targetUid", "targetName", "chatId", "reason", "status", "createdAt", "updatedAt"]
    },
    "StudyInvite": {
      "title": "StudyInvite",
      "description": "6-character Study Group invite lookup record for joining without exposing phone numbers.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "description": "Uppercase alphanumeric invite code" },
        "chatId": { "type": "string", "description": "Target group chat ID" },
        "title": { "type": "string", "description": "Study group title" },
        "description": { "type": "string", "description": "Study group description" },
        "createdBy": { "type": "string", "description": "Creator UID" },
        "isActive": { "type": "boolean", "description": "Whether the invite code accepts joins" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["inviteCode", "chatId", "title", "description", "createdBy", "isActive", "createdAt", "updatedAt"]
    },
    "StudyItem": {
      "title": "StudyItem",
      "description": "Shared note, class routine slot, or exam countdown inside a Study Chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "itemType": { "type": "string", "enum": ["note", "routine", "exam"], "description": "Study board item type" },
        "title": { "type": "string", "description": "Note title, subject name, or exam name" },
        "details": { "type": "string", "description": "Detailed summary, chapter, or syllabus" },
        "scheduleText": { "type": "string", "description": "Day/time label for routine or exam hall" },
        "examDateEpochMs": { "type": "integer", "description": "Optional exam target epoch ms" },
        "createdBy": { "type": "string", "description": "Creator UID" },
        "createdByName": { "type": "string", "description": "Creator display name" },
        "participantUids": { "type": "array", "description": "Denormalized chat participant UIDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["chatId", "itemType", "title", "details", "scheduleText", "examDateEpochMs", "createdBy", "createdByName", "participantUids", "createdAt", "updatedAt"]
    },
    "TeacherPlan": {
      "title": "TeacherPlan",
      "description": "Pre-configured monthly or yearly Teacher subscription plan managed in Admin Console (no payment gateway required yet).",
      "type": "object",
      "properties": {
        "planId": { "type": "string", "description": "Unique plan identifier" },
        "name": { "type": "string", "description": "Plan display title" },
        "billingCycle": { "type": "string", "enum": ["free", "monthly", "yearly"], "description": "Billing frequency" },
        "priceBdt": { "type": "integer", "description": "Planned price in BDT (0 for free launch)" },
        "priceUsd": { "type": "integer", "description": "Optional international price in USD" },
        "maxStudyGroups": { "type": "integer", "description": "Maximum study groups included in plan" },
        "maxStudentsPerGroup": { "type": "integer", "description": "Maximum students per group" },
        "features": { "type": "array", "description": "Bullet list of included plan benefits" },
        "isActive": { "type": "boolean", "description": "Whether plan is active" },
        "sortOrder": { "type": "integer", "description": "Display order" },
        "createdBy": { "type": "string", "description": "Admin UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["planId", "name", "billingCycle", "priceBdt", "maxStudyGroups", "maxStudentsPerGroup", "features", "isActive", "sortOrder", "createdBy", "createdAt", "updatedAt"]
    },
    "TeacherBillingRecord": {
      "title": "TeacherBillingRecord",
      "description": "Admin-managed manual teacher subscription ledger ready for future monetization without live payment gateway.",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string", "description": "Teacher user UID" },
        "teacherName": { "type": "string", "description": "Teacher display name" },
        "planId": { "type": "string", "description": "Assigned plan ID" },
        "planName": { "type": "string", "description": "Assigned plan title" },
        "billingCycle": { "type": "string", "enum": ["free", "monthly", "yearly"], "description": "Billing cycle" },
        "amountBdt": { "type": "integer", "description": "Fee amount in BDT" },
        "paymentMethod": { "type": "string", "enum": ["free_launch", "manual_bkash", "manual_nagad", "manual_bank", "manual_cash", "promo"], "description": "Manual or promo payment method" },
        "referenceNote": { "type": "string", "description": "Transaction ID or admin note" },
        "status": { "type": "string", "enum": ["active", "pending", "paid", "expired", "waived"], "description": "Subscription ledger status" },
        "periodStartEpochMs": { "type": "integer", "description": "Period start epoch ms" },
        "periodEndEpochMs": { "type": "integer", "description": "Period end epoch ms" },
        "recordedBy": { "type": "string", "description": "Admin UID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["teacherUid", "teacherName", "planId", "planName", "billingCycle", "amountBdt", "paymentMethod", "referenceNote", "status", "periodStartEpochMs", "periodEndEpochMs", "recordedBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public discoverable profiles of Alap users (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document storing the user's email."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Authorized secondary administrators."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global application settings managed by admin."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
